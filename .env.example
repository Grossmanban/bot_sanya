# Токен бота от @BotFather
BOT_TOKEN=123456789:AA...
# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=111111111,222222222
# Домен, на котором будет Mini App (нужен HTTPS — Caddy получит сертификат сам)
DOMAIN=grafik.example.ru
# Адрес Mini App для кнопки в боте
WEBAPP_URL=https://grafik.example.ru
# Часовой пояс для дат и «Распреда на завтра»
TIMEZONE=Europe/Moscow
# Файл базы SQLite (в Docker не трогать: лежит в ./data)
# DB_PATH=./data/bot.db
